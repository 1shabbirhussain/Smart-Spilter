rules_version = '2';

// Smart Split keeps ALL of its data under smart_split/app/... so this
// Firebase project can be shared with other apps. If other apps already have
// rules in this project, merge the `match /smart_split/app` block into them
// instead of replacing the whole file.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function app(p) {
      return /databases/$(database)/documents/smart_split/app/$(p);
    }

    match /smart_split/app {

      // Public profiles. A username may only be set if the matching
      // usernames/{name} claim belongs to the same user (checked post-write).
      match /users/{uid} {
        allow read: if signedIn();
        allow create, update: if isUser(uid)
          && (!('username' in request.resource.data)
              || (resource != null && request.resource.data.username == resource.data.get('username', null))
              || getAfter(app('usernames/' + request.resource.data.username)).data.uid == uid);

        match /friends/{friendUid} {
          allow read: if isUser(uid);
          // Owner manages their list; the other side may add itself while
          // accepting a pending request, and either side may unfriend.
          allow create: if isUser(uid)
            || (isUser(friendUid) && exists(app('friendRequests/' + uid + '_' + friendUid)));
          allow update: if isUser(uid);
          allow delete: if isUser(uid) || isUser(friendUid);
        }

        match /notifications/{id} {
          allow read, delete: if isUser(uid);
          allow update: if isUser(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
          allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        }
      }

      // Unique username claims: usernames/{name} -> { uid }
      match /usernames/{name} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && name.matches('^[a-z0-9_.]{3,20}$');
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Pending friend requests, id = {fromUid}_{toUid}
      match /friendRequests/{id} {
        allow read: if signedIn()
          && (resource == null
              || resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid != request.auth.uid
          && id == request.auth.uid + '_' + request.resource.data.toUid;
        allow delete: if signedIn()
          && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid);
      }

      // Shared groups. Any linked member can read and edit; members are
      // stored inline and memberUids lists the linked accounts.
      match /groups/{groupId} {
        function isMember() {
          return signedIn()
            && request.auth.uid in get(app('groups/' + groupId)).data.memberUids;
        }

        allow read: if signedIn()
          && (resource == null || request.auth.uid in resource.data.memberUids);
        allow create: if signedIn()
          && request.auth.uid in request.resource.data.memberUids;
        // Existing members may edit, soft-delete, or leave (remove themselves)
        allow update: if signedIn() && request.auth.uid in resource.data.memberUids;
        allow delete: if false; // soft delete via `deleted: true`

        match /expenses/{expenseId} {
          allow read, create, update: if isMember();
          allow delete: if false;
        }

        match /settlements/{settlementId} {
          allow read, create, update: if isMember();
          allow delete: if false;
        }
      }
    }
  }
}
